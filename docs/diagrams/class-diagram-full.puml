@startuml
title MissionOS - Implemented Class Diagram
left to right direction
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0

package "nonprofit" {
  class Main
}

package "nonprofit.view" {
  class AuthenticationDialog <<View>>
  class ConsoleAuthenticationDialog <<View>>
  class ConsoleView <<View>> {
    - in: Scanner
  }
  class ControlPanelView <<View>>
  class Theme <<View>> {
    + install(): void
    + toggle(): void
    + isDark(): boolean
  }
  class Ui <<View>> {
    ~ table(model): JTable
    ~ searchable(table): JPanel
    ~ form(parts): JPanel
    ~ primary(button): JButton
  }
  class DashboardPanel <<View>> {
    - controller: DashboardPanelController
  }
  abstract class TabPanel <<View>> {
    # newModel(columns): DefaultTableModel
    # button(text, action): JButton
    # selectedId(table, what): int
    # confirmDelete(what): boolean
    # run(action): void
  }
  class DonationsPanel <<View>> {
    - controller: DonationPanelController
  }
  class VolunteersPanel <<View>> {
    - controller: VolunteerPanelController
  }
  class EventsPanel <<View>> {
    - controller: EventPanelController
    - lookups: LookupPanelController
  }
  class BeneficiariesPanel <<View>> {
    - controller: BeneficiaryPanelController
    - lookups: LookupPanelController
  }
  class NotificationsPanel <<View>> {
    - controller: NotificationPanelController
  }
  class LookupPanel <<View>> {
    - controller: LookupPanelController
  }
}

package "nonprofit.controller" {
  class MainController <<Controller>> {
    - view: ConsoleView
    - donations: DonationController
    - volunteers: VolunteerController
    - events: EventController
    - beneficiaries: BeneficiaryController
    - lookups: LookupController
  }
  class DonationController <<Controller>> {
    - service: DonationService
    - view: ConsoleView
  }
  class VolunteerController <<Controller>> {
    - service: VolunteerService
    - view: ConsoleView
  }
  class EventController <<Controller>> {
    - service: EventService
    - view: ConsoleView
  }
  class BeneficiaryController <<Controller>> {
    - service: BeneficiaryService
    - view: ConsoleView
  }
  class LookupController <<Controller>> {
    - service: LookupService
    - view: ConsoleView
    - CATEGORIES: String[]
  }
  class DonationPanelController <<Controller>> {
    - service: DonationService
  }
  class VolunteerPanelController <<Controller>> {
    - service: VolunteerService
  }
  class EventPanelController <<Controller>> {
    - service: EventService
  }
  class BeneficiaryPanelController <<Controller>> {
    - service: BeneficiaryService
  }
  class DashboardPanelController <<Controller>> {
    - donations: DonationService
    - volunteers: VolunteerService
    - events: EventService
    - beneficiaries: BeneficiaryService
    + getStats(): Map<String, String>
    + getRecentDonations(limit): List<Donation>
  }
  class LookupPanelController <<Controller>> {
    - service: LookupService
  }
  class NotificationPanelController <<Controller>> {
    - donations: DonationService
    - volunteers: VolunteerService
    - beneficiaries: BeneficiaryService
    - notifier: Notifier
    + send(audience, recipient, channel, message): List<String>
  }
}

package "nonprofit.service" {
  class SupabaseAuthService <<Service>> {
    - client: SupabaseRestClient
  }
  class "SupabaseAuthService.AuthSession" as AuthSession {
    - accessToken: String
    - refreshToken: String
  }
  class DonationService <<Service>> {
    - db: DataStore
    + addDonor(name, email, phone, channel): Donor
    + updateDonor(id, name, email, phone, channel): boolean
    + deleteDonor(id): boolean
    + donate(donor, type, amount, detail, giftAid, matching, months): Donation
    + applyDecorators(donation, giftAid, matching, months): DonationInfo
    + getDonationTypes(): List<String>
  }
  class VolunteerService <<Service>> {
    - db: DataStore
    + add(name, email, skill): Volunteer
    + addSkill(id, skill): boolean
    + setAvailability(id, days): boolean
    + matchBySkill(skill): List<Volunteer>
    + matchByAvailability(day): List<Volunteer>
  }
  class EventService <<Service>> {
    - db: DataStore
    - TICKET_START: int {static}
    + create(name, date, location, type, skills): Event
    + assignVolunteer(eventId, volunteerId): boolean
    + suggestVolunteers(eventId): List<Volunteer>
    + register(eventId, volunteerId): Registration
    + issueTicket(eventId, volunteerId): Ticket
    + markAttendance(ticketId): boolean
  }
  class BeneficiaryService <<Service>> {
    - db: DataStore
    + add(name, contact, need): Beneficiary
    + update(id, name, contact, need): boolean
    + delete(id): boolean
  }
  class LookupService <<Service>> {
    - db: DataStore
    + add(name, category): LookupItem
    + getByCategory(category): List<LookupItem>
    + update(id, newName): boolean
    + delete(id): boolean
  }
  class DonationFactory <<Factory>> {
    + create(type, donor, amount, detail): Donation
  }
}

package "nonprofit.repository" {
  class DataStore <<Singleton>> {
    - instance: DataStore
    + donors: Repository<Donor>
    + donations: Repository<Donation>
    + volunteers: Repository<Volunteer>
    + events: Repository<Event>
    + beneficiaries: Repository<Beneficiary>
    + lookups: Repository<LookupItem>
    + registrations: Repository<Registration>
    + tickets: Repository<Ticket>
    + configure(client): void
    + getInstance(): DataStore
  }
  interface "Repository<T>" as Repository <<Repository>> {
    + add(item): T
    + getById(id): T
    + getAll(): List<T>
    + save(item): boolean
    + remove(id): boolean
  }
  class "SupabaseRepository<T>" as SupabaseRepository {
    - client: SupabaseRestClient
    - table: String
    - codec: EntityJsonCodec<T>
  }
  class DonationRepository {
    - donorCodec: EntityJsonCodec<Donor>
  }
  class EventRepository
  class "EntityJsonCodec<T>" as EntityJsonCodec {
    - entityType: Class<T>
    - gson: Gson
  }
  class SupabaseConfig {
    - url: String
    - apiKey: String
  }
  class SupabaseRestClient {
    - TABLE_NAME: Pattern
    - TIMEOUT_MILLIS: int
    - baseUrl: String
    - apiKey: String
    - accessToken: String
    - refreshToken: String
    - httpClient: HttpClient
    - gson: Gson
  }
  class SupabaseException {
    + SupabaseException(message)
    + SupabaseException(message, cause)
  }
}

package "Supabase (PostgreSQL + Auth)" <<Database>> {
  class "Supabase Database" as SupabaseDB <<Database>> {
    Row Level Security: authenticated users only
    Entity attributes stored as JSONB "data"
  }
  class "donors" as T_donors <<table>> {
    id: integer PK
    data: jsonb
  }
  class "donations" as T_donations <<table>> {
    id: integer PK
    donor_id: integer FK
    data: jsonb
  }
  class "volunteers" as T_volunteers <<table>> {
    id: integer PK
    data: jsonb
  }
  class "events" as T_events <<table>> {
    id: integer PK
    data: jsonb
  }
  class "event_volunteers" as T_event_volunteers <<table>> {
    id: integer PK
    event_id: integer FK
    volunteer_id: integer FK
  }
  class "beneficiaries" as T_beneficiaries <<table>> {
    id: integer PK
    data: jsonb
  }
  class "lookups" as T_lookups <<table>> {
    id: integer PK
    data: jsonb
  }
  class "registrations" as T_registrations <<table>> {
    id: integer PK
    event_id: integer FK
    volunteer_id: integer FK
    data: jsonb
  }
  class "tickets" as T_tickets <<table>> {
    id: integer PK
    event_id: integer FK
    volunteer_id: integer FK
    data: jsonb
  }
}

package "nonprofit.model" {
  abstract class Entity {
    # id: int
  }
  class Donor {
    - name: String
    - email: String
    - phone: String
    - notificationChannel: String
  }
  abstract class Donation {
    # donor: Donor
    # amount: double
    # date: LocalDate
    # decoratorDescription: String
    + getType(): String
    + describe(): String
  }
  interface DonationInfo {
    + getAmount(): double
    + describe(): String
  }
  class OnlineDonation
  class CheckDonation
  class InKindDonation {
    - item: String
  }
  abstract class DonationDecorator {
    # wrapped: DonationInfo
  }
  class GiftAidDecorator
  class MatchingFundDecorator
  class RecurringDecorator {
    - months: int
  }
  class Volunteer {
    - name: String
    - email: String
    - skills: List<String>
    - availability: List<String>
    - hours: double
  }
  class Event {
    - name: String
    - date: String
    - location: String
    - eventType: String
    - status: String
    - volunteers: List<Volunteer>
    - requiredSkills: List<String>
  }
  class Beneficiary {
    - name: String
    - contact: String
    - need: String
  }
  class LookupItem {
    - name: String
    - category: String
  }
  class Registration {
    - volunteerId: int
    - eventId: int
    - registrationDate: String
  }
  class Ticket {
    - ticketNumber: String
    - eventId: int
    - volunteerId: int
    - checkedIn: boolean
  }
}

package "nonprofit.observer" {
  class Subject {
    - observers: List<Observer>
    + attach(observer): void
    + detach(observer): void
    # notifyObservers(eventType, data): void
  }
  interface Observer {
    + update(eventType, data): void
  }
}

package "nonprofit.communication" {
  class DonationReceiptObserver {
    - notifier: Notifier
  }
  class EventUpdateObserver {
    - notifier: Notifier
  }
  class Notifier <<Strategy Context>> {
    - strategy: NotificationStrategy
    + setStrategy(strategy): void
    + notify(to, message): void
  }
  interface NotificationStrategy <<Strategy>> {
    + send(to, message): void
    + format(to, message): String
  }
  class EmailStrategy
  class SmsStrategy
  class SocialMediaStrategy
  class NotificationFactory <<Factory>> {
    + create(type): NotificationStrategy
  }
}

