@startuml
title MissionOS - Layers (MVC) and Persistence
skinparam shadowing false
skinparam defaultFontName Calibri
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam roundCorner 6
skinparam nodesep 26
skinparam ranksep 42
skinparam packageStyle rectangle
skinparam ArrowColor #44546A
skinparam ClassBorderColor #44546A
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassHeaderBackgroundColor #E9EEF5
skinparam PackageBorderColor #8497B0
skinparam PackageBackgroundColor #FAFBFD
skinparam PackageFontStyle bold
skinparam LegendBackgroundColor #FFF8E1
skinparam LegendBorderColor #BF9000
hide circle
hide empty members
package "View" {
  class ControlPanelView
  class ConsoleView
  class "Tab panels" as Tabs <<7 classes>>
}
package "Controller" {
  class "Panel controllers" as PC <<6 classes>>
  class "Console controllers" as CC <<6 classes>>
}
package "Service" {
  class DonationService
  class VolunteerService
  class EventService
  class BeneficiaryService
  class LookupService
}
package "Persistence" {
  class DataStore <<Singleton>> {
    - {static} instance : DataStore
    + {static} getInstance() : DataStore
  }
  interface "Repository<T>" as Repository {
    + add(item) : T
    + getById(id) : T
    + getAll() : List<T>
    + save(item) : boolean
    + remove(id) : boolean
  }
  class "SupabaseRepository<T>" as SupabaseRepository
  class SupabaseRestClient
}
ControlPanelView *--> Tabs
Tabs --> PC
CC --> ConsoleView
PC --> DonationService
PC --> VolunteerService
PC --> EventService
PC --> BeneficiaryService
PC --> LookupService
CC --> DonationService
CC --> VolunteerService
CC --> EventService
CC --> BeneficiaryService
CC --> LookupService
DonationService --> DataStore
VolunteerService --> DataStore
EventService --> DataStore
BeneficiaryService --> DataStore
LookupService --> DataStore
DataStore o--> "8" Repository
Repository <|.. SupabaseRepository
SupabaseRepository --> SupabaseRestClient
@enduml
