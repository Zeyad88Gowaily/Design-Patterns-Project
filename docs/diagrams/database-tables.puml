@startuml
skinparam shadowing false
skinparam defaultFontName Calibri
skinparam defaultFontSize 12
skinparam nodesep 25
skinparam ranksep 35
skinparam ClassBackgroundColor #EAF3FB
skinparam ClassBorderColor #1F4E79
skinparam ArrowColor #1F4E79
hide circle
entity donors {
  *id : integer
  data : jsonb
}
entity donations {
  *id : integer
  donor_id : integer (FK)
  data : jsonb
}
entity volunteers {
  *id : integer
  data : jsonb
}
entity events {
  *id : integer
  data : jsonb
}
entity event_volunteers {
  *id : integer
  event_id : integer (FK)
  volunteer_id : integer (FK)
}
entity registrations {
  *id : integer
  event_id : integer (FK)
  volunteer_id : integer (FK)
  data : jsonb
}
entity tickets {
  *id : integer
  event_id : integer (FK)
  volunteer_id : integer (FK)
  data : jsonb
}
entity beneficiaries {
  *id : integer
  data : jsonb
}
entity lookups {
  *id : integer
  data : jsonb
}
donors ||--o{ donations
events ||--o{ event_volunteers
volunteers ||--o{ event_volunteers
events ||--o{ registrations
volunteers ||--o{ registrations
events ||--o{ tickets
volunteers ||--o{ tickets
@enduml
