@startuml
title MissionOS - Supabase tables (Phase 1)
skinparam shadowing false
skinparam defaultFontName Calibri
skinparam defaultFontSize 13
skinparam classAttributeIconSize 0
skinparam roundCorner 6
skinparam nodesep 55
skinparam ranksep 110
skinparam linetype ortho
skinparam ArrowColor #44546A
skinparam ClassBorderColor #44546A
skinparam LegendBackgroundColor #FFFFFF
skinparam LegendBorderColor #8497B0
hide circle
hide empty members

legend top right
  |= Colour |= Layer |
  | <back:#DDEBF7>   View   </back> | Swing / console screens |
  | <back:#E2F0D9>   Controller   </back> | MVC controllers |
  | <back:#FFF2CC>   Service   </back> | business rules |
  | <back:#FCE4D6>   Patterns   </back> | Observer, Strategy, Factory |
  | <back:#EDEDED>   Persistence   </back> | Singleton, repositories, Supabase client |
  | <back:#D9D2E9>   Model   </back> | entities, Decorator |
  | <back:#C6E0B4>   Supabase   </back> | hosted database |
endlegend

class "Supabase project" as Supabase <<Database>> #C6E0B4 {
  Auth: email + password
  PostgREST over HTTPS (anon key)
  Row level security
}
class "donors" as T_donors <<table>> #E2F0D9 {
  id : integer PK
  data : jsonb
}
class "donations" as T_donations <<table>> #E2F0D9 {
  id : integer PK
  donor_id : integer FK
  data : jsonb
}
class "volunteers" as T_volunteers <<table>> #E2F0D9 {
  id : integer PK
  data : jsonb
}
class "events" as T_events <<table>> #E2F0D9 {
  id : integer PK
  data : jsonb
}
class "event_volunteers" as T_event_volunteers <<table>> #E2F0D9 {
  id : integer PK
  event_id : integer FK
  volunteer_id : integer FK
}
class "registrations" as T_registrations <<table>> #E2F0D9 {
  id : integer PK
  event_id : integer FK
  volunteer_id : integer FK
  data : jsonb
}
class "tickets" as T_tickets <<table>> #E2F0D9 {
  id : integer PK
  event_id : integer FK
  volunteer_id : integer FK
  data : jsonb
}
class "beneficiaries" as T_beneficiaries <<table>> #E2F0D9 {
  id : integer PK
  data : jsonb
}
class "lookups" as T_lookups <<table>> #E2F0D9 {
  id : integer PK
  data : jsonb
}

Supabase *-- T_donors
Supabase *-- T_donations
Supabase *-- T_volunteers
Supabase *-- T_events
Supabase *-- T_event_volunteers
Supabase *-- T_registrations
Supabase *-- T_tickets
Supabase *-- T_beneficiaries
Supabase *-- T_lookups
T_donations "*" --> "1" T_donors
T_event_volunteers "*" --> "1" T_events
T_event_volunteers "*" --> "1" T_volunteers
T_registrations "*" --> "1" T_events
T_registrations "*" --> "1" T_volunteers
T_tickets "*" --> "1" T_events
T_tickets "*" --> "1" T_volunteers
@enduml
